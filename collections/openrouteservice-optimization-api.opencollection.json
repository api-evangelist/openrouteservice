    }
  },
  "items": [
    {
      "info": {
        "name": "Optimization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vehicle Route Optimization",
            "type": "http"
          },
          "http": {
            "method": "POST",
